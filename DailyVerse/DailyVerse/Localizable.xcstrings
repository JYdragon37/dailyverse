        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 아침 눈을 뜨자마자 \"주님, 오늘도 말씀으로 시작할게요\"라고 한 마디 건네봐."
          }
        }
      }
    },
    "onboarding.experience.end": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료"
          }
        }
      }
    },
    "onboarding.experience.end.accessibility": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop alarm and go to verse screen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람 종료 후 말씀 화면으로"
          }
        }
      }
    },
    "onboarding.experience.greeting1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did you sleep well?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘 잤어요?"
          }
        }
      }
    },
    "onboarding.experience.greeting2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rise and shine, %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "힘차게 기지개 펴요, %@"
          }
        }
      }
    },
    "onboarding.experience.interpretation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "David prayed this while his soul was crushed, pursued by enemies. \"Loving-kindness\" points to God's unchanging love and faithfulness — that love arrives before any morning does. Opening the Word before the day begins is already an act of trusting God."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다윗이 원수들에게 쫓겨 영혼이 짓눌린 상황에서 드린 기도야. '인자한 말씀'은 변하지 않는 하나님의 사랑과 신실함을 가리켜 — 어떤 아침이든 그 사랑이 먼저 도착해 있어. 하루를 시작하기 전, 말씀을 여는 것 자체가 이미 하나님을 의뢰하는 행동이야."
          }
        }
      }
    },
    "onboarding.experience.reference": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Psalm 143:8"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시편 143:8"
          }
        }
      }
    },
    "onboarding.experience.snooze": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snooze"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스누즈"
          }
        }
      }
    },
    "onboarding.experience.verseFull": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let me hear Your loving-kindness in the morning,\nfor I trust in You;\nteach me the way I should go,\nfor I lift up my soul to You."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아침에 나로 하여금 주의 인자한 말씀을 듣게 하소서\n내가 주를 의뢰함이니이다\n내가 다닐 길을 알게 하소서\n내가 내 영혼을 주께 드림이니이다"
          }
        }
      }
    },
    "onboarding.experience.verseShort": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let me hear Your loving-kindness\nin the morning, for I trust in You"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아침에 나로 하여금\n주의 인자한 말씀을 듣게 하소서"
          }
        }
      }
    },
    "onboarding.experience.wakeUpMessage": {
