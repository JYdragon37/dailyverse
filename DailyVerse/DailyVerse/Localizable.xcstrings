    "alarm.permission.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AlarmKit permission has been denied.\nIf you fully quit the app, alarms may not sound.\nPlease allow the Alarm permission for morning manna in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AlarmKit 권한이 거부되어 있어요.\n앱을 완전히 종료하면 알람이 울리지 않을 수 있어요.\n설정 앱에서 마이만나 → 알람 권한을 허용해주세요."
          }
        }
      }
    },
